# Copy to .env for local development. Never commit real values.
NODE_ENV=development
DATABASE_URL=postgres://warden:warden_dev@localhost:5432/warden_dev
# Generate with: pnpm --filter @warden/api gen-keys
WARDEN_FIELD_KEY=
WARDEN_HMAC_KEY=
WARDEN_FIELD_KEY_ID=k1
PORT=8080
LOG_LEVEL=info
MIGRATE_ON_START=true
# Serve the built console from the API (same origin): ../console/dist
CONSOLE_DIST=
