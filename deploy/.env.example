# Copy to deploy/.env on the server. Never commit the real file.
DOMAIN=api.example.ng
# openssl rand -hex 24
POSTGRES_PASSWORD=
# Each key: openssl rand -base64 32
WARDEN_FIELD_KEY=
WARDEN_HMAC_KEY=
# Signs responder broadcasts: openssl rand -base64 32
WARDEN_SIGNING_KEY=
# Key ids and old keys: only change these when replacing a key (docs/deploy.md, "Changing keys").
WARDEN_FIELD_KEY_ID=k1
WARDEN_OLD_FIELD_KEYS=
WARDEN_SIGNING_KEY_ID=s1
# Only if you set up USSD: openssl rand -hex 24
USSD_CALLBACK_SECRET=
# Text messages to trusted contacts (SOS, late trips). Leave as "log" until the SMS account is
# ready; then set SMS_DRIVER=termii and paste the key from the Termii dashboard.
SMS_DRIVER=log
TERMII_API_KEY=
TERMII_SENDER_ID=Warden
# News feeds whose headlines moderators review on the News page (RSS or Atom, https only),
# for example: Outlet One|https://outlet-one.example/feed,Outlet Two|https://outlet-two.example/rss
WARDEN_NEWS_FEEDS=
