<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.Andsv.EditText" parent="android:Widget">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/faint</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Widget.Andsv.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/border_strong</item>
        <item name="android:textColor">@color/ink</item>
        <item name="rippleColor">@color/brand_wash</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">10dp</item>
    </style>

    <style name="Widget.Andsv.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Andsv.Label" parent="android:Widget">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
    </style>
</resources>
