<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Brand -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_brand_mark">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_check" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/app_name"
                android:textColor="@color/ink"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/pairing_explainer"
            android:textColor="@color/ink_dim"
            android:textSize="14sp" />

        <!-- Pairing card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                style="@style/Text.Monitor.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/server_label" />

            <EditText
                android:id="@+id/baseUrl"
                style="@style/Widget.Monitor.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:autofillHints="url"
                android:hint="@string/server_hint"
                android:inputType="textUri" />

            <TextView
                style="@style/Text.Monitor.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/code_label" />

            <EditText
                android:id="@+id/pairCode"
                style="@style/Widget.Monitor.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:autofillHints="off"
                android:hint="@string/code_hint"
                android:inputType="number"
                android:letterSpacing="0.2"
                android:maxLength="8"
                android:textSize="18sp" />

            <CheckBox
                android:id="@+id/consentCheckbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:buttonTint="@color/brand"
                android:text="@string/consent_label"
                android:textColor="@color/ink_dim"
                android:textSize="14sp" />

            <Button
                android:id="@+id/pairButton"
                style="@style/Widget.Monitor.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/pair_button" />
        </LinearLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/ink_dim"
            android:textSize="14sp" />

        <!-- Permissions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <Button
                android:id="@+id/usageAccessButton"
                style="@style/Widget.Monitor.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/grant_usage"
                android:visibility="gone" />

            <Button
                android:id="@+id/notifAccessButton"
                style="@style/Widget.Monitor.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/grant_notifications"
                android:visibility="gone" />

            <Button
                android:id="@+id/accessibilityButton"
                style="@style/Widget.Monitor.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/grant_accessibility"
                android:visibility="gone" />

            <Button
                android:id="@+id/screenShareButton"
                style="@style/Widget.Monitor.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/allow_screen"
                android:visibility="gone" />

            <Button
                android:id="@+id/adminButton"
                style="@style/Widget.Monitor.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/enable_admin"
                android:visibility="gone" />

            <Button
                android:id="@+id/hideIconButton"
                style="@style/Widget.Monitor.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/hide_icon"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
